{$SITE_DOMAINS} {
	log

	# Block sensitive files
	@blocked {
		path *.env* */.env* /.* /.*/ *.git* *.sql *.bak *.log *.ini *.conf
	}
	respond @blocked 404

	handle /static/* {
		root * /agmp/static_cdn
		uri strip_prefix /static
		file_server
	}

	handle /media/* {
		root * /agmp/media
		uri strip_prefix /media
		file_server
	}

	handle {
		reverse_proxy djangoapp:8000
	}

	encode gzip
}